{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/watchface.schema.json",
  "title": "WatchFace authoring format (Tier 1)",
  "description": "Human/tool authoring layer compiled by wfc into the WFB binary runtime layer.",
  "type": "object",
  "required": ["version", "screen", "resources", "widgets"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },

    "screen": {
      "type": "object",
      "required": ["w", "h"],
      "additionalProperties": false,
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "h": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bg": { "$ref": "#/$defs/color" }
      }
    },

    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": { "type": "array", "items": { "$ref": "#/$defs/image" } },
        "fonts":  { "type": "array", "items": { "$ref": "#/$defs/font" } },
        "anims":  { "type": "array", "items": { "$ref": "#/$defs/anim" } }
      }
    },

    "widgets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/widget" }
    }
  },

  "$defs": {
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },

    "align": {
      "type": "string",
      "enum": [
        "center", "top_left", "top_mid", "top_right",
        "bottom_left", "bottom_mid", "bottom_right",
        "left_mid", "right_mid"
      ]
    },

    "eventCode": {
      "type": "string",
      "enum": ["clicked", "pressed", "released", "long_pressed", "value_changed"]
    },

    "image": {
      "type": "object",
      "required": ["name", "file"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "file": { "type": "string" }
      }
    },

    "font": {
      "type": "object",
      "required": ["name", "file"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "file": { "type": "string" }
      }
    },

    "anim": {
      "type": "object",
      "required": ["name", "duration"],
      "additionalProperties": false,
      "properties": {
        "name":     { "$ref": "#/$defs/name" },
        "duration": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "repeat":   { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },

    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_color": { "$ref": "#/$defs/color" },
        "bg_color":   { "$ref": "#/$defs/color" },
        "bg_opa":     { "type": "integer", "minimum": 0, "maximum": 255 },
        "arc_width":  { "type": "integer", "minimum": 0, "maximum": 65535 },
        "arc_color":  { "$ref": "#/$defs/color" }
      }
    },

    "event": {
      "type": "object",
      "required": ["on", "call"],
      "additionalProperties": false,
      "properties": {
        "on":    { "$ref": "#/$defs/eventCode" },
        "call":  { "$ref": "#/$defs/name" },
        "param": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },

    "widget": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id":        { "$ref": "#/$defs/name" },
        "type":      { "type": "string", "enum": ["screen", "image", "label", "frame_anim", "arc", "bar", "container", "imglabel"] },
        "parent":    { "$ref": "#/$defs/name" },
        "align":     { "$ref": "#/$defs/align" },
        "x":         { "type": "integer", "minimum": -32768, "maximum": 32767 },
        "y":         { "type": "integer", "minimum": -32768, "maximum": 32767 },
        "w":         { "type": "integer", "minimum": -2, "maximum": 32767 },
        "h":         { "type": "integer", "minimum": -2, "maximum": 32767 },
        "image":     { "$ref": "#/$defs/name" },
        "font":      { "$ref": "#/$defs/name" },
        "anim":      { "$ref": "#/$defs/name" },
        "text":      { "type": "string" },
        "clickable": { "type": "boolean" },
        "hidden":    { "type": "boolean" },
        "style":     { "$ref": "#/$defs/style" },
        "events":    { "type": "array", "items": { "$ref": "#/$defs/event" } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "image" } } },
          "then": { "required": ["image"] } },
        { "if": { "properties": { "type": { "const": "label" } } },
          "then": { "required": ["font", "text"] } },
        { "if": { "properties": { "type": { "const": "frame_anim" } } },
          "then": { "required": ["anim"] } },
        { "if": { "properties": { "type": { "const": "imglabel" } } },
          "then": { "required": ["image"] } }
      ]
    }
  }
}
